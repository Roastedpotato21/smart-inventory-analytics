{
  "name": "smart-inventory-analytics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data:generate": "node scripts/generate-data.mjs",
    "verify:assets": "node scripts/verify-assets.mjs && node scripts/generate-data.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run verify:assets && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
